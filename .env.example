DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production
DB_NAME=django_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DJANGO_PORT=8000
# DJANGO_DEBUG=True

OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-oss-20b
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-5-0-pro
# Optional Gemini Developer API image generation. Product copy and chart reading still use OpenRouter.
IMAGE_GENERATION_PROVIDER=openrouter
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
MODEL_TRYON_PROVIDER=openrouter_masked
FASHN_API_KEY=
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# From localhost, use a WordPress account with media upload permission.
WORDPRESS_MEDIA_USER=
WORDPRESS_MEDIA_APP_PASSWORD=
# Alternatively, set the public HTTPS URL of the project's media directory.
PUBLIC_MEDIA_BASE_URL=

# Caption defaults and optional Meta account checks.
SOCIAL_CURRENCY=LKR
SOCIAL_BRAND_NAME=
META_GRAPH_API_VERSION=
META_APP_ID=
META_APP_SECRET=
OPENROUTER_CHART_MODEL=openai/gpt-4o-mini
OPENROUTER_PRODUCT_VISION_MODEL=openai/gpt-4o-mini
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional for separate Instagram Login. Leave blank for a Page-linked account.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# TikTok photo upload sends a draft to the TikTok inbox. Use a verified public HTTPS media prefix.
TIKTOK_ACCESS_TOKEN=
TIKTOK_MEDIA_BASE_URL=
TIKTOK_MEDIA_SOURCE=storage
